						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{jwt_token}}"
							}
						],
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "content",
									"value": "{\n    \"title\": \"Distributed Systems Principles\",\n    \"author\": \"Andrew Tanenbaum\",\n    \"description\": \"Comprehensive guide on SOA and microservice architectures.\",\n    \"type\": \"BOOK\"\n}",
									"contentType": "application/json",
									"type": "text"
								},
								{
									"key": "file",
									"type": "file",
									"src": ""
