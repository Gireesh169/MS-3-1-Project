						"url": {
							"raw": "{{gateway_url}}/content/{{content_id}}",
							"host": [
								"{{gateway_url}}"
							],
							"path": [
								"content",
								"{{content_id}}"
							]
						},
						"description": "Deletes a content item by its ID."
					},
					"response": []
				},
				{
					"name": "2.5 Security Test - No Token (Expected 401)",
					"request": {
						"method": "GET",
						"header": [],
