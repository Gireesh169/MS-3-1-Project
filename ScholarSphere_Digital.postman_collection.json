	"item": [
		{
			"name": "01 - Authentication Service",
			"description": "Public authentication endpoints for registering and logging in users. Token is automatically saved to collection variable 'jwt_token'.",
			"item": [
				{
					"name": "1.1 Register User",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"gireesh\",\n    \"email\": \"gireesh@example.com\",\n    \"password\": \"Password123!\",\n    \"role\": \"USER\"\n}"
						},
						"url": {
							"raw": "{{gateway_url}}/api/auth/register",
							"host": [
								"{{gateway_url}}"
							],
							"path": [
								"api",
								"auth",
								"register"
							]
						},
						"description": "Registers a standard USER with username, email, password, and USER role."
					},
					"response": []
				},
				{
					"name": "1.2 Register Admin",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"admin_user\",\n    \"email\": \"admin@example.com\",\n    \"password\": \"AdminPassword123!\",\n    \"role\": \"ADMIN\"\n}"
						},
						"url": {
							"raw": "{{gateway_url}}/api/auth/register",
							"host": [
								"{{gateway_url}}"
							],
							"path": [
								"api",
								"auth",
								"register"
							]
						},
						"description": "Registers an ADMIN user with ADMIN role."
					},
					"response": []
				},
				{
					"name": "1.3 Login User (Auto-captures Token)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var responseText = pm.response.text().trim();",
									"try {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.token) {",
									"        pm.collectionVariables.set('jwt_token', jsonData.token);",
									"    } else {",
									"        pm.collectionVariables.set('jwt_token', responseText);",
									"}",
									"} catch (e) {",
									"    pm.collectionVariables.set('jwt_token', responseText);",
									"}",
									"console.log('JWT Token captured: ' + pm.collectionVariables.get('jwt_token'));"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"gireesh\",\n    \"password\": \"Password123!\"\n}"
						},
						"url": {
							"raw": "{{gateway_url}}/api/auth/login",
							"host": [
								"{{gateway_url}}"
							],
							"path": [
								"api",
								"auth",
								"login"
							]
						},
						"description": "Logs in the USER. Test script automatically saves the returned JWT to {{jwt_token}}."
					},
					"response": []
				},
				{
					"name": "1.4 Login Admin (Auto-captures Admin Token)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var responseText = pm.response.text().trim();",
									"try {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.token) {",
									"        pm.collectionVariables.set('admin_jwt_token', jsonData.token);",
									"    } else {",
									"        pm.collectionVariables.set('admin_jwt_token', responseText);",
									"    }",
									"} catch (e) {",
									"    pm.collectionVariables.set('admin_jwt_token', responseText);",
									"}",
									"console.log('Admin JWT Token captured: ' + pm.collectionVariables.get('admin_jwt_token'));"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"admin_user\",\n    \"password\": \"AdminPassword123!\"\n}"
						},
						"url": {
							"raw": "{{gateway_url}}/api/auth/login",
							"host": [
								"{{gateway_url}}"
							],
							"path": [
								"api",
								"auth",
								"login"
							]
						},
						"description": "Logs in the ADMIN user. Test script saves the returned JWT to {{admin_jwt_token}}."
					},
					"response": []
				},
				{
					"name": "1.5 Direct Service Login (:8081)",
